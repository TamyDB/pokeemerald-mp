[Unit]
Description=Allow Pokemon Emerald UDP relay
After=network-pre.target netfilter-persistent.service
Before=network.target

[Service]
Type=oneshot
EnvironmentFile=/etc/pokeemerald-server.env
ExecStart=/bin/sh -c '/usr/sbin/iptables -C INPUT -p udp --dport "${POKE_NET_PORT}" -j ACCEPT || /usr/sbin/iptables -I INPUT 1 -p udp --dport "${POKE_NET_PORT}" -j ACCEPT'
ExecStop=/bin/sh -c '/usr/sbin/iptables -D INPUT -p udp --dport "${POKE_NET_PORT}" -j ACCEPT || true'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
